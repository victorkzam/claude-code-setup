# Default-deny: this template ships no working ~/.claude state, only source
# files. Anything that isn't explicitly tracked in the include manifest below
# should never accidentally get swept into this repo by a future commit.
*

# Explicitly allow tracked template files and directories.
!.gitignore
!.gitattributes
!README.md
!LICENSE
!CLAUDE.md
!WORKFLOW.md
!settings.example.json
!rules/
!rules/**
!agents/
!agents/**
!skills/
!skills/**
!hooks/
!hooks/**
!tests/
!tests/**

# Track the plugin manifest directory.
!.claude-plugin/
!.claude-plugin/**

# Allow the project-local design-artifact directories under docs/plans/:
# a future single-file design doc (docs/plans/<slug>.md) and this build's
# folder (docs/plans/cw-plugin/) are tracked; any other docs/plans/<other>/
# folder stays ignored. Gitignore requires un-ignoring each parent directory
# level before its children, so the chain below is intentionally explicit
# rather than a single !docs/plans/**.
!docs/
!docs/plans/
!docs/plans/*.md
!docs/plans/cw-plugin/
!docs/plans/cw-plugin/**

!.github/
!.github/**

# Never track local, personal, or generated Claude Code state, even if a
# future copy step drops it in here by mistake.
settings.json
settings.local.json
.claude.json
.mcp.json
/plans/
projects/
history.jsonl
*.log
.DS_Store

# Security rail: this repo must never ship an active repo-local settings
# file, even though other repo-local .claude paths may be tracked above.
.claude/settings.json
